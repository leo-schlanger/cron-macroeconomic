# Database (Postgres local da VPS)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database

# IA (curator.py). Plano gratuito: só GEMINI_API_KEY (triagem no Flash-Lite,
# artigos no Flash, cada um com cota diária própria). Opcionais, usados se houver chave:
GEMINI_API_KEY=...
# GROQ_API_KEY=...              # grátis, sem cartão (Llama 3.3 70B), reserva extra
# OPENROUTER_API_KEY=...        # pago, aceita cripto (USDC); dá acesso ao Claude
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# ANTHROPIC_API_KEY=sk-ant-...  # direto na Anthropic

# Curadoria (padrões)
CURATOR_MIN_IMPACT=7      # nota mínima de impacto (0-10) para publicar
CURATOR_PER_RUN=2         # máximo por rodada (cron a cada 2h)
CURATOR_DAILY_MAX=12      # máximo por dia

# Legado (processor.py): ollama só entra com AI_PROVIDER=ollama
AI_PROVIDER=gemini
